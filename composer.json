{
    "name": "ideal-postcodes/laravel",
    "description": "Laravel package for the Ideal Postcodes PHP SDK: set your API key in .env, then inject the client or any resource, or call the facade",
    "type": "library",
    "keywords": [
        "ideal postcodes",
        "laravel",
        "address",
        "postcode",
        "postcode lookup",
        "uk"
    ],
    "homepage": "https://ideal-postcodes.co.uk",
    "license": "SEE LICENSE IN LICENSE",
    "authors": [
        {
            "name": "Ideal Postcodes",
            "email": "support@ideal-postcodes.co.uk",
            "homepage": "https://ideal-postcodes.co.uk"
        }
    ],
    "support": {
        "email": "support@ideal-postcodes.co.uk",
        "docs": "https://docs.ideal-postcodes.co.uk/docs/sdks/php/laravel",
        "issues": "https://github.com/ideal-postcodes/feedback/issues"
    },
    "require": {
        "php": "^8.2",
        "ideal-postcodes/sdk": "^0.1",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.9",
        "laravel/pint": "^1.21",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.8",
        "php-http/mock-client": "^1.6",
        "phpstan/phpstan": "^2.1"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../php",
            "options": {
                "versions": {
                    "ideal-postcodes/sdk": "0.1.0"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "IdealPostcodes\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IdealPostcodes\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "IdealPostcodes\\Laravel\\IdealPostcodesServiceProvider"
            ],
            "aliases": {
                "IdealPostcodes": "IdealPostcodes\\Laravel\\Facades\\IdealPostcodes"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "scripts": {
        "lint": "pint --test",
        "lint:fix": "pint",
        "test:types": [
            "phpstan analyse --memory-limit=512M",
            "phpstan analyse --memory-limit=512M -c phpstan.tests.neon.dist"
        ],
        "test:unit": "pest --colors=always",
        "test": [
            "@lint",
            "@test:types",
            "@test:unit"
        ]
    }
}
